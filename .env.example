# AirAware AI 2.0 — Environment Configuration Template
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit real API keys or secrets to version control.

# Google Gemini API Key (Server-side only)
# Optional: when omitted, AirAware AI 2.0 runs deterministically using verified environmental rules.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Open-Meteo Upstream API Endpoints (Free, CC BY 4.0, no API key required)
OPEN_METEO_AIR_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEO_URL=https://geocoding-api.open-meteo.com/v1/search

# Server Cache TTL Configuration (milliseconds)
AIR_QUALITY_CACHE_TTL_MS=600000
WEATHER_CACHE_TTL_MS=900000
GEOCODING_CACHE_TTL_MS=86400000

# API Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_STANDARD_MAX=60
RATE_LIMIT_AI_MAX=20

# Optional Public App Metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
